{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:auditor-security:schema:audit-report:1.0.0",
  "title": "Auditor Security Audit Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill",
    "project",
    "audit",
    "summary",
    "findings",
    "tools",
    "limitations",
    "verification"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "skill": {
      "const": "auditor-security"
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "technologies"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "technologies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "coverage_tier"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "version_confidence": {
                "enum": [
                  "high",
                  "medium",
                  "low",
                  "unknown"
                ]
              },
              "coverage_tier": {
                "enum": [
                  "tier_1_verified",
                  "tier_2_supported",
                  "tier_3_best_effort"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "required": [
        "date",
        "scope",
        "execution_level"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "type": [
            "string",
            "null"
          ]
        },
        "execution_level": {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4"
          ]
        },
        "source_review_date": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "total_findings",
        "confirmed",
        "probable",
        "potential"
      ],
      "properties": {
        "total_findings": {
          "type": "integer",
          "minimum": 0
        },
        "confirmed": {
          "type": "integer",
          "minimum": 0
        },
        "probable": {
          "type": "integer",
          "minimum": 0
        },
        "potential": {
          "type": "integer",
          "minimum": 0
        },
        "by_severity": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_priority": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "category",
          "status",
          "confidence",
          "severity",
          "priority",
          "component",
          "locations",
          "evidence",
          "preconditions",
          "impact",
          "recommendation",
          "verification",
          "references",
          "limitations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AS-[A-Z]+-[0-9]{3,}$"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "status": {
            "enum": [
              "confirmed",
              "probable",
              "potential",
              "misconfiguration",
              "hardening",
              "informational"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "none",
              "unknown"
            ]
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3",
              "P4",
              "unassigned"
            ]
          },
          "cvss": {
            "type": [
              "object",
              "null"
            ]
          },
          "component": {
            "type": "string"
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "start_line": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "end_line": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "endpoint": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "detail": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "impact": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "verification": {
            "type": "object",
            "required": [
              "status",
              "procedure"
            ],
            "properties": {
              "status": {
                "enum": [
                  "not_run",
                  "passed",
                  "failed",
                  "partially_passed",
                  "blocked",
                  "not_applicable"
                ]
              },
              "procedure": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "result": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "skipped",
              "not_run"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "not_run",
              "passed",
              "failed",
              "partially_passed",
              "blocked",
              "not_applicable"
            ]
          },
          "details": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "details"
        ],
        "additionalProperties": false
      }
    }
  }
}
